{
  "name": "@collabcode/collaboration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@collabcode/shared": "workspace:*",
    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/provider": "^2.15.0",
    "@hocuspocus/server": "^2.15.0",
    "@prisma/client": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "yjs": "^13.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
