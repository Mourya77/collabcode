{
  "name": "collabcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --write .",
    "db:validate": "pnpm --filter @collabcode/api exec prisma validate",
    "db:format": "pnpm --filter @collabcode/api exec prisma format",
    "db:generate": "pnpm --filter @collabcode/api exec prisma generate"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  }
}
