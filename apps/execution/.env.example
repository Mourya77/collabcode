NODE_ENV=development
PORT=4002
CORS_ORIGIN=http://localhost:5173
# Shared secret with apps/api. Required (the API sends it as x-internal-token
# on every call). The built-in dev default is rejected when NODE_ENV=production.
EXECUTION_INTERNAL_TOKEN=<MASKED_SECRET_002>
# docker = production runner (isolated containers, default).
# subprocess = DEV/TEST ONLY, runs code on the host with NO isolation —
# the service refuses to boot with it when NODE_ENV=production.
EXECUTION_RUNNER=docker
EXECUTION_TIMEOUT_MS=10000
EXECUTION_MEMORY_MB=256
EXECUTION_MAX_OUTPUT_KB=64
EXECUTION_MAX_CONCURRENT=4
# EXECUTION_WORKSPACES_DIR=/var/tmp/collabcode-exec
