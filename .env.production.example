# ============================================================================
# CollabCode — PRODUCTION environment reference (Phase 8)
#
# This file documents EVERY production variable, per service. It contains
# NO real values — copy the relevant block into the host's dashboard
# (Render / Vercel), never into git. Full runbook: docs/deployment.md.
# Legend: [secret] = generate a unique random value, never reuse a dev
# default (the services REFUSE to boot in production with dev defaults).
# ============================================================================

# ---------------------------------------------------------------------------
# collabcode-api  (Render web service — render.yaml)
# ---------------------------------------------------------------------------
NODE_ENV=production
# Injected by Render automatically; the API listens on it.
PORT=
# [secret] Managed Postgres connection string (Render: fromDatabase).
DATABASE_URL=
# [secret] Signs access JWTs AND collab tokens. >= 32 chars.
# MUST be the SAME value on collabcode-api and collabcode-collab.
JWT_SECRET=
# Lifetimes (defaults are fine): access token minutes / refresh token days.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# [secret] Guards the API -> collab internal restore endpoint. >= 16 chars.
# MUST be the SAME value on collabcode-api and collabcode-collab.
COLLAB_INTERNAL_TOKEN=
# Where the API reaches the collab service's internal endpoint. This is the
# collab service's PUBLIC https origin (single-port mode serves the
# internal endpoint on the same port as the WebSockets).
COLLAB_INTERNAL_URL=https://collabcode-collab.onrender.com
# Comma-separated browser origins allowed by CORS (credentials are
# involved, so no wildcards). PASS 2: set to the exact Vercel origin.
CORS_ORIGINS=https://YOUR-APP.vercel.app
# Public origin of the SPA — used to build invitation links.
APP_BASE_URL=https://YOUR-APP.vercel.app
# "true"/"false". Defaults to true when NODE_ENV=production — the session
# cookies are Secure + SameSite=Lax; keep it true behind HTTPS.
# COOKIE_SECURE=true
# Rate limits (requests per 15 min window per IP; defaults shown).
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# Invitation lifetime in days.
INVITATION_TTL_DAYS=7
# --- Code execution (DISABLED by default in production) ---
# Leave EXECUTION_SERVICE_URL UNSET to run the public deployment with code
# execution disabled: POST /executions then returns
# 503 {"code":"EXECUTION_DISABLED"} and the UI shows a calm notice.
# Only set it when a dedicated, isolated, Docker-capable execution host
# has passed the checklist in docs/execution-security.md.
# EXECUTION_SERVICE_URL=https://execution.internal.example.com
# [secret] Required by the API's production guard EVEN while execution is
# disabled (the value is then unused). When execution is enabled it MUST
# match the execution service's EXECUTION_INTERNAL_TOKEN.
EXECUTION_INTERNAL_TOKEN=
# Per-user execution limits (only relevant when execution is enabled).
# EXECUTION_RATE_LIMIT_MAX=30        # creations per user per hour
# EXECUTION_USER_INFLIGHT_MAX=2      # simultaneous runs per user
# --- Optional: real email delivery for invitations ---
# When SMTP_HOST is unset, invitations run in dev-link mode (the link is
# returned to the inviter instead of emailed). Set all five to send mail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CollabCode <no-reply@example.com>

# ---------------------------------------------------------------------------
# collabcode-collab  (Render web service — render.yaml)
# ---------------------------------------------------------------------------
NODE_ENV=production
# Injected by Render. In production, an explicitly set PORT switches the
# server to SINGLE-PORT mode: WebSockets + GET /health + the internal
# restore endpoint all on $PORT (Render exposes exactly one port).
PORT=
# [secret] Same managed Postgres as the API (fromDatabase).
DATABASE_URL=
# [secret] Verifies collab tokens. Set JWT_SECRET to the SAME value as the
# API's JWT_SECRET (or set COLLAB_JWT_SECRET instead, which takes priority).
JWT_SECRET=
# COLLAB_JWT_SECRET=
# [secret] SAME value as the API's COLLAB_INTERNAL_TOKEN.
COLLAB_INTERNAL_TOKEN=
# Comma-separated browser origins allowed to open WebSockets. PASS 2:
# set to the exact Vercel origin — foreign origins are rejected at upgrade.
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
# "true"/"false" override for single-port mode. Leave unset on Render
# (derived automatically from NODE_ENV=production + PORT present).
# SINGLE_PORT=
# Persistence tuning (defaults shown; rarely changed).
# STORE_DEBOUNCE_MS=2000
# MAX_DEBOUNCE_MS=10000
# VERSION_SYNC_MIN_INTERVAL_MS=30000
# COLLAB_STORE_MAX_ATTEMPTS=4
# COLLAB_STORE_SWEEP_MS=5000
# Dual-port (local/VPS) mode only: the separate health listener port.
# HEALTH_PORT=4003

# ---------------------------------------------------------------------------
# collabcode-web  (Vercel project, root directory: apps/web)
# Build-time variables — baked into the bundle, NOT secrets.
# ---------------------------------------------------------------------------
# Public origin of the API (no trailing slash). Used for REST + chat WS.
VITE_API_URL=https://collabcode-api.onrender.com
# Public WebSocket origin of the collab service (wss://).
VITE_COLLAB_URL=wss://collabcode-collab.onrender.com

# ---------------------------------------------------------------------------
# collabcode-execution  (NOT part of the public deployment)
# Only on a dedicated, isolated, Docker-capable host — see
# docs/execution-security.md. Never expose its port publicly.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4002
# [secret] MUST match the API's EXECUTION_INTERNAL_TOKEN.
EXECUTION_INTERNAL_TOKEN=
# Must stay "docker" in production. "subprocess" has NO isolation and the
# service refuses to boot with it when NODE_ENV=production.
EXECUTION_RUNNER=docker
# EXECUTION_TIMEOUT_MS=10000       # per-job wall clock (hard max 30000)
# EXECUTION_MEMORY_MB=256          # per-job memory cap
# EXECUTION_MAX_OUTPUT_KB=64       # stdout/stderr cap per stream
# EXECUTION_MAX_CONCURRENT=4
# EXECUTION_WORKSPACES_DIR=        # parent dir for per-job temp workspaces
