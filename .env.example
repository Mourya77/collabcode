# Copy to .env for docker compose / local defaults. No real secrets.
POSTGRES_USER=collabcode
POSTGRES_PASSWORD=collabcode_dev_password
POSTGRES_DB=collabcode
DATABASE_URL=postgresql://collabcode:collabcode_dev_password@localhost:5432/collabcode?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
COLLABORATION_PORT=4001
COLLABORATION_HEALTH_PORT=4003
EXECUTION_PORT=4002
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
# Phase 5 — shared secret between the API and the internal execution service
# (must match on both; use a real secret outside local development).
EXECUTION_INTERNAL_TOKEN=<MASKED_SECRET_002>
EXECUTION_RUNNER=docker
