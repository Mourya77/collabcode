# @collabcode/api — copy to .env for local development. No real secrets.
NODE_ENV=development
PORT=4000
# Postgres connection string (docker compose default shown; the sandbox helper
# `pnpm db:dev-db start` serves 127.0.0.1:55433 with user/password postgres).
DATABASE_URL=postgresql://collabcode:collabcode_dev_password@localhost:5432/collabcode?schema=public
# >= 32 chars. The built-in dev default is rejected when NODE_ENV=production.
JWT_SECRET=dev-only-jwt-secret-change-in-production-0123456789
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated CORS allowlist (credentials are enabled).
CORS_ORIGINS=http://localhost:5173
# Secure cookies: defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# Rate limits per IP per RATE_LIMIT_WINDOW_MS (defaults 300 global / 20 auth).
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# LOG_LEVEL=info
# Phase 4 — invitations: base URL used to build invite links, and invite TTL.
APP_BASE_URL=http://localhost:5173
INVITATION_TTL_DAYS=7
# Phase 4 — mailer: leave SMTP_HOST unset for development (the invitation link
# is logged and returned in the create response). Production: set all of these
# (or wire a provider like Resend/SES — see docs/api.md "Mailer configuration").
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CollabCode <no-reply@example.com>
# Phase 5 — code execution: the internal execution service (apps/execution).
# The token must match EXECUTION_INTERNAL_TOKEN on the service; the built-in
# dev default is rejected when NODE_ENV=production.
EXECUTION_SERVICE_URL=http://localhost:4002
EXECUTION_INTERNAL_TOKEN=<MASKED_SECRET_002>
# Execution creation limits: 30 runs/hour/user, max 2 in flight per user.
# EXECUTION_RATE_LIMIT_MAX=30
# EXECUTION_USER_INFLIGHT_MAX=2
